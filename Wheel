<body class="bg-slate-900 text-slate-100 min-h-screen font-sans flex flex-col justify-between selection:bg-brand-500 selection:text-white">

    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/20">
                    <i class="fa-solid font-bold fa-dharmachakra text-white text-xl animate-spin-slow"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">Glücksrad Pro</h1>
                    <p class="text-xs text-slate-400">Erstelle dein eigenes Rad &amp; drehe es!</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button id="copyCodeBtn" onclick="copyFullCode()" class="flex items-center gap-2 px-3 py-2 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-medium text-sm rounded-xl shadow-lg shadow-teal-500/20 transition-all active:scale-95">
                    <i class="fa-solid fa-copy"></i>
                    <span class="hidden sm:inline">Code kopieren</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto px-4 py-6 w-full flex-grow grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Side: Wheel Display -->
        <section class="lg:col-span-7 flex flex-col items-center justify-center gap-6 bg-slate-800/40 border border-slate-800 p-6 rounded-3xl backdrop-blur-sm relative">
            
            <!-- Wheel Container -->
            <div class="relative w-full max-w-[420px] aspect-square flex items-center justify-center my-2">
                <!-- Outer Glow Effect -->
                <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-indigo-500/20 via-purple-500/20 to-pink-500/20 blur-2xl -z-10"></div>
                
                <!-- Pointer / Stopper -->
                <div id="pointer" class="absolute -top-3 z-20 w-8 h-10 left-1/2 -translate-x-1/2 flex justify-center drop-shadow-lg">
                    <div class="w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[28px] border-t-amber-400 filter drop-shadow-md"></div>
                </div>

                <!-- Canvas Wheel -->
                <canvas id="wheelCanvas" width="800" height="800" class="w-full h-full rounded-full shadow-2xl border-4 border-slate-700/80 cursor-pointer transition-transform duration-75"></canvas>
            </div>

            <!-- Controls below Wheel -->
            <div class="flex flex-wrap items-center justify-center gap-4 w-full">
                <button id="spinBtn" onclick="spinWheel()" class="w-full sm:w-auto min-w-[200px] px-8 py-4 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-600 hover:via-purple-600 hover:to-pink-600 text-white font-bold text-xl rounded-2xl shadow-xl shadow-purple-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-play mr-2"></i> JETZT DREHEN!
                </button>
            </div>

            <!-- Quick Settings Bar -->
            <div class="flex items-center justify-between w-full max-w-md pt-4 border-t border-slate-800 text-xs text-slate-400">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="soundToggle" checked="" class="rounded border-slate-700 bg-slate-900 text-indigo-500 focus:ring-indigo-500">
                    <span><i class="fa-solid fa-volume-high mr-1"></i> Ton effekte</span>
                </label>
                
                <div class="flex items-center gap-2">
                    <span>Palette:</span>
                    <select id="paletteSelect" onchange="changePalette()" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-slate-200 focus:outline-none focus:border-indigo-500">
                        <option value="neon">Neon Vibes</option>
                        <option value="pastel">Pastell Traum</option>
                        <option value="rainbow">Regenbogen</option>
                        <option value="classic">Casino Klassiker</option>
                    </select>
                </div>
            </div>

        </section>

        <!-- Right Side: Items Management & Presets -->
        <section class="lg:col-span-5 flex flex-col gap-6">
            
            <!-- Items Box -->
            <div class="bg-slate-800/40 border border-slate-800 p-5 rounded-3xl flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <h2 class="font-bold text-slate-200 text-base flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-indigo-400"></i> Einträge (<span id="itemCount">6</span>)
                    </h2>
                    <button onclick="clearAllItems()" class="text-xs text-rose-400 hover:text-rose-300 transition-colors">
                        <i class="fa-solid fa-trash-can mr-1"></i> Alle löschen
                    </button>
                </div>

                <!-- Add Input -->
                <form onsubmit="addItemFromInput(event)" class="flex gap-2">
                    <input type="text" id="newItemInput" placeholder="Neuer Eintrag..." class="flex-grow bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-xl transition-colors">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </form>

                <!-- Preset Buttons -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                    <span class="text-xs text-slate-400 w-full mb-1">Schnell-Vorlagen:</span>
                    <button onclick="loadPreset('yesno')" class="px-2.5 py-1 bg-slate-900 hover:bg-slate-700 border border-slate-700 rounded-lg text-xs text-slate-300">Ja / Nein</button>
                    <button onclick="loadPreset('food')" class="px-2.5 py-1 bg-slate-900 hover:bg-slate-700 border border-slate-700 rounded-lg text-xs text-slate-300">Was essen?</button>
                    <button onclick="loadPreset('numbers')" class="px-2.5 py-1 bg-slate-900 hover:bg-slate-700 border border-slate-700 rounded-lg text-xs text-slate-300">Zahlen 1-6</button>
                    <button onclick="loadPreset('movies')" class="px-2.5 py-1 bg-slate-900 hover:bg-slate-700 border border-slate-700 rounded-lg text-xs text-slate-300">Film-Genre</button>
                </div>

                <!-- Items List -->
                <div id="itemsContainer" class="max-h-[260px] overflow-y-auto space-y-2 pr-1 mt-2"><div class="flex items-center justify-between p-2.5 rounded-xl border transition-all bg-slate-900/80 border-slate-700">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" checked="" onchange="toggleItem(1)" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">Option A</span>
                    </div>
                    <button onclick="deleteItem(1)" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div><div class="flex items-center justify-between p-2.5 rounded-xl border transition-all bg-slate-900/80 border-slate-700">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" checked="" onchange="toggleItem(2)" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">Option B</span>
                    </div>
                    <button onclick="deleteItem(2)" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div><div class="flex items-center justify-between p-2.5 rounded-xl border transition-all bg-slate-900/80 border-slate-700">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" checked="" onchange="toggleItem(3)" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">Option C</span>
                    </div>
                    <button onclick="deleteItem(3)" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div><div class="flex items-center justify-between p-2.5 rounded-xl border transition-all bg-slate-900/80 border-slate-700">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" checked="" onchange="toggleItem(4)" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">Option D</span>
                    </div>
                    <button onclick="deleteItem(4)" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div><div class="flex items-center justify-between p-2.5 rounded-xl border transition-all bg-slate-900/80 border-slate-700">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" checked="" onchange="toggleItem(5)" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">Option E</span>
                    </div>
                    <button onclick="deleteItem(5)" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div><div class="flex items-center justify-between p-2.5 rounded-xl border transition-all bg-slate-900/80 border-slate-700">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" checked="" onchange="toggleItem(6)" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">Option F</span>
                    </div>
                    <button onclick="deleteItem(6)" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div></div>
            </div>

            <!-- History Box -->
            <div class="bg-slate-800/40 border border-slate-800 p-5 rounded-3xl flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-slate-300 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-history text-indigo-400"></i> Vergangene Gewinner
                    </h3>
                    <button onclick="clearHistory()" class="text-xs text-slate-500 hover:text-slate-300">Verlauf leeren</button>
                </div>
                <div id="historyContainer" class="flex flex-wrap gap-2 max-h-[100px] overflow-y-auto">
                    <p class="text-xs text-slate-500 italic">Noch keine Gewinner.</p>
                </div>
            </div>

        </section>

    </main>

    <!-- Winner Modal Overlay -->
    <div id="winnerModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50 opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="bg-slate-900 border border-slate-700 p-8 rounded-3xl max-w-md w-full text-center flex flex-col items-center gap-4 transform scale-90 transition-transform duration-300 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-indigo-500/20 rounded-full blur-xl"></div>
            <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-amber-400 to-yellow-200 flex items-center justify-center text-slate-950 text-2xl shadow-lg shadow-amber-500/30">
