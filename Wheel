            <div>
                <span class="text-xs font-semibold text-indigo-400 uppercase tracking-widest">Gewinner!</span>
                <h2 id="winnerResultText" class="text-3xl font-extrabold text-white mt-1 break-words">Eintrag</h2>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full mt-2">
                <button onclick="closeWinnerModal(false)" class="flex-1 px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium text-sm rounded-xl transition-colors">
                    Schließen
                </button>
                <button onclick="closeWinnerModal(true)" class="flex-1 px-4 py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-medium text-sm rounded-xl transition-colors">
                    Gewinner entfernen
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 bg-emerald-600 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 z-50">
        <i class="fa-solid fa-circle-check text-lg"></i>
        <span id="toastMsg" class="text-sm font-medium">Erfolgreich kopiert!</span>
    </div>

    <script>
        // Default State
        let items = [
            { id: 1, text: 'Option A', active: true },
            { id: 2, text: 'Option B', active: true },
            { id: 3, text: 'Option C', active: true },
            { id: 4, text: 'Option D', active: true },
            { id: 5, text: 'Option E', active: true },
            { id: 6, text: 'Option F', active: true }
        ];

        let history = [];
        let currentRotation = 0; // in radians
        let isSpinning = false;
        let selectedWinner = null;
        let currentPalette = 'neon';

        // Color Palettes
        const palettes = {
            neon: ['#8b5cf6', '#ec4899', '#3b82f6', '#10b981', '#f59e0b', '#06b6d4'],
            pastel: ['#fca5a5', '#fcd34d', '#86efac', '#93c5fd', '#c084fc', '#f472b6'],
            rainbow: ['#ef4444', '#f97316', '#eab308', '#22c55e', '#06b6d4', '#3b82f6', '#a855f7'],
            classic: ['#dc2626', '#1e293b', '#dc2626', '#1e293b', '#dc2626', '#1e293b']
        };

        const canvas = document.getElementById('wheelCanvas');
        const ctx = canvas.getContext('2d');

        // Initializer
        window.onload = function() {
            loadSavedData();
            renderItemsList();
            drawWheel();
        };

        // --- Local Storage Management ---
        function saveData() {
            localStorage.setItem('wheel_items', JSON.stringify(items));
            localStorage.setItem('wheel_history', JSON.stringify(history));
            localStorage.setItem('wheel_palette', currentPalette);
        }

        function loadSavedData() {
            const savedItems = localStorage.getItem('wheel_items');
            if (savedItems) items = JSON.parse(savedItems);

            const savedHistory = localStorage.getItem('wheel_history');
            if (savedHistory) {
                history = JSON.parse(savedHistory);
                renderHistory();
            }

            const savedPalette = localStorage.getItem('wheel_palette');
            if (savedPalette) {
                currentPalette = savedPalette;
                document.getElementById('paletteSelect').value = savedPalette;
            }
        }

        // --- Audio Synthesizer (No external files required) ---
        function playTickSound() {
            if (!document.getElementById('soundToggle').checked) return;
            try {
                const ctxAudio = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctxAudio.createOscillator();
                const gain = ctxAudio.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, ctxAudio.currentTime);
                osc.frequency.exponentialRampToValueAtTime(80, ctxAudio.currentTime + 0.04);
                gain.gain.setValueAtTime(0.15, ctxAudio.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctxAudio.currentTime + 0.04);
                osc.connect(gain);
                gain.connect(ctxAudio.destination);
                osc.start();
                osc.stop(ctxAudio.currentTime + 0.04);
            } catch(e) {}
        }

        function playVictorySound() {
            if (!document.getElementById('soundToggle').checked) return;
            try {
                const ctxAudio = new (window.AudioContext || window.webkitAudioContext)();
                const notes = [261.63, 329.63, 392.00, 523.25]; // C E G C
                notes.forEach((freq, idx) => {
                    const osc = ctxAudio.createOscillator();
                    const gain = ctxAudio.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, ctxAudio.currentTime + idx * 0.1);
                    gain.gain.setValueAtTime(0.2, ctxAudio.currentTime + idx * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctxAudio.currentTime + idx * 0.1 + 0.3);
                    osc.connect(gain);
                    gain.connect(ctxAudio.destination);
                    osc.start(ctxAudio.currentTime + idx * 0.1);
                    osc.stop(ctxAudio.currentTime + idx * 0.1 + 0.3);
                });
            } catch(e) {}
        }

        // --- Wheel Canvas Drawing ---
        function getActiveItems() {
            return items.filter(i => i.active);
        }

        function drawWheel() {
            const activeItems = getActiveItems();
            const numSegments = activeItems.length;
            const width = canvas.width;
            const height = canvas.height;
            const centerX = width / 2;
            const centerY = height / 2;
            const radius = width / 2 - 20;

            ctx.clearRect(0, 0, width, height);

            if (numSegments === 0) {
                // Empty Wheel state
                ctx.beginPath();
                ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI);
                ctx.fillStyle = '#334155';
                ctx.fill();
                ctx.lineWidth = 10;
                ctx.strokeStyle = '#475569';
                ctx.stroke();

                ctx.fillStyle = '#94a3b8';
                ctx.font = 'bold 32px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('Bitte Einträge hinzufügen', centerX, centerY);
                return;
            }

            const arcSize = (2 * Math.PI) / numSegments;
            const colors = palettes[currentPalette] || palettes.neon;

            ctx.save();
            ctx.translate(centerX, centerY);
            ctx.rotate(currentRotation);

            for (let i = 0; i < numSegments; i++) {
                const angle = i * arcSize;
                const color = colors[i % colors.length];

                // Draw Segment Sector
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.arc(0, 0, radius, angle, angle + arcSize);
                ctx.fillStyle = color;
                ctx.fill();
                ctx.lineWidth = 4;
                ctx.strokeStyle = '#0f172a';
                ctx.stroke();

                // Draw Text
                ctx.save();
                ctx.rotate(angle + arcSize / 2);
                ctx.textAlign = 'right';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 28px sans-serif';
                ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
                ctx.shadowBlur = 6;

                let text = activeItems[i].text;
                if (text.length > 18) text = text.substring(0, 15) + '...';
                ctx.fillText(text, radius - 40, 0);
                ctx.restore();
            }

            // Draw Center Pin
            ctx.beginPath();
            ctx.arc(0, 0, 50, 0, 2 * Math.PI);
            ctx.fillStyle = '#0f172a';
            ctx.fill();
            ctx.lineWidth = 6;
            ctx.strokeStyle = '#38bdf8';
            ctx.stroke();

            ctx.restore();
        }

        // --- Spin Mechanism ---
        function spinWheel() {
            const activeItems = getActiveItems();
            if (activeItems.length < 1 || isSpinning) return;

            isSpinning = true;
            document.getElementById('spinBtn').disabled = true;

            const duration = 4000; // 4 seconds
            const startTime = performance.now();
            const startRotation = currentRotation;

            // Extra full rotations plus randomized slice
            const extraRotations = (5 + Math.random() * 5) * 2 * Math.PI;
            const targetRotation = startRotation + extraRotations;

            let lastSegmentIndex = -1;

            function animate(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);

                // Cubic ease-out deceleration curve
                const easeOut = 1 - Math.pow(1 - progress, 3);
                currentRotation = startRotation + easeOut * extraRotations;

                // Calculate tick sounds on segment boundary crossing
                const numSegments = activeItems.length;
                const arcSize = (2 * Math.PI) / numSegments;
                // Pointer is at top (-PI/2)
                const normalizedAngle = (2 * Math.PI - (currentRotation % (2 * Math.PI)) + (3 * Math.PI / 2)) % (2 * Math.PI);
                const currentSegmentIndex = Math.floor(normalizedAngle / arcSize);

                if (currentSegmentIndex !== lastSegmentIndex) {
                    playTickSound();
                    const pointerEl = document.getElementById('pointer');
                    pointerEl.classList.remove('tick-anim');
                    void pointerEl.offsetWidth; // trigger reflow
                    pointerEl.classList.add('tick-anim');
                    lastSegmentIndex = currentSegmentIndex;
                }

                drawWheel();

                if (progress < 1) {
                    requestAnimationFrame(animate);
                } else {
                    isSpinning = false;
                    document.getElementById('spinBtn').disabled = false;
                    
                    // Determine Winner
                    selectedWinner = activeItems[currentSegmentIndex];
                    showWinner(selectedWinner);
                }
            }

            requestAnimationFrame(animate);
        }

        // --- Winner Popup & Effects ---
        function showWinner(item) {
            playVictorySound();
            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 }
            });

            // Add to history
            history.unshift({ text: item.text, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) });
            if (history.length > 20) history.pop();
            saveData();
            renderHistory();

            // Open Modal
            document.getElementById('winnerResultText').innerText = item.text;
            const modal = document.getElementById('winnerModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.querySelector('div').classList.remove('scale-90');
            modal.querySelector('div').classList.add('scale-100');
        }

        function closeWinnerModal(removeItem = false) {
            const modal = document.getElementById('winnerModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.querySelector('div').classList.remove('scale-100');
            modal.querySelector('div').classList.add('scale-90');

            if (removeItem && selectedWinner) {
                deleteItem(selectedWinner.id);
            }
        }

        // --- Item Management ---
        function renderItemsList() {
            const container = document.getElementById('itemsContainer');
            document.getElementById('itemCount').innerText = items.length;
            container.innerHTML = '';

            items.forEach(item => {
                const el = document.createElement('div');
                el.className = `flex items-center justify-between p-2.5 rounded-xl border transition-all ${
                    item.active ? 'bg-slate-900/80 border-slate-700' : 'bg-slate-900/30 border-slate-800 opacity-50'
                }`;
                el.innerHTML = `
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input type="checkbox" ${item.active ? 'checked' : ''} onchange="toggleItem(${item.id})" class="rounded border-slate-700 bg-slate-800 text-indigo-500 focus:ring-indigo-500">
                        <span class="text-sm font-medium text-slate-200 truncate">${escapeHtml(item.text)}</span>
                    </div>
                    <button onclick="deleteItem(${item.id})" class="text-slate-500 hover:text-rose-400 p-1 transition-colors">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                `;
                container.appendChild(el);
            });

            drawWheel();
        }

        function addItemFromInput(e) {
            e.preventDefault();
            const input = document.getElementById('newItemInput');
            const text = input.value.trim();
            if (!text) return;

            items.push({ id: Date.now(), text: text, active: true });
            input.value = '';
            saveData();
            renderItemsList();
        }

        function toggleItem(id) {
            const item = items.find(i => i.id === id);
            if (item) {
                item.active = !item.active;
                saveData();
                renderItemsList();
            }
        }

        function deleteItem(id) {
            items = items.filter(i => i.id !== id);
            saveData();
            renderItemsList();
        }

        function clearAllItems() {
            items = [];
            saveData();
            renderItemsList();
        }

        function changePalette() {
            currentPalette = document.getElementById('paletteSelect').value;
            saveData();
            drawWheel();
        }

        // --- Presets ---
        function loadPreset(key) {
            const presets = {
                yesno: ['Ja', 'Nein', 'Vielleicht'],
                food: ['Pizza', 'Burger', 'Sushi', 'Döner', 'Salat', 'Pasta'],
                numbers: ['1', '2', '3', '4', '5', '6'],
                movies: ['Action', 'Komödie', 'Horror', 'Sci-Fi', 'Drama', 'Animation']
            };

            if (presets[key]) {
                items = presets[key].map((text, idx) => ({ id: Date.now() + idx, text: text, active: true }));
                saveData();
                renderItemsList();
            }
        }

        // --- History ---
        function renderHistory() {
            const container = document.getElementById('historyContainer');
            if (history.length === 0) {
                container.innerHTML = '<p class="text-xs text-slate-500 italic">Noch keine Gewinner.</p>';
                return;
            }
            container.innerHTML = history.map(h => `
                <span class="px-2.5 py-1 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-indigo-300 flex items-center gap-1">
                    <span class="font-semibold text-white">${escapeHtml(h.text)}</span>
                    <span class="text-[10px] text-slate-500">${h.time}</span>
                </span>
            `).join('');
        }

        function clearHistory() {
            history = [];
            saveData();
            renderHistory();
        }

        // Helper to prevent HTML injection
        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        // --- Copy HTML Code Helper ---
        function copyFullCode() {
            const fullHtml = document.documentElement.outerHTML;
            
            // Temporary text area for clipboard execCommand compatibility
            const textarea = document.createElement('textarea');
            textarea.value = '<!DOCTYPE html>\n<' + fullHtml + '>';
            document.body.appendChild(textarea);
            textarea.select();
            
            try {
                document.execCommand('copy');
                showToast('Gesamter HTML-Code in Zwischenablage kopiert!');
            } catch (err) {
                showToast('Kopieren fehlgeschlagen.');
            }
            
            document.body.removeChild(textarea);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0', 'translate-y-20');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-20');
            }, 3000);
        }
    </script>

